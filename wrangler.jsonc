{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-center-admin", // 可自定义为你的 Worker 名称
  "compatibility_date": "2026-11-02",
  // 脚本入口：有了 main 才不是「仅静态资产」Worker，控制台才开放变量/绑定等能力
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist/",
    // Worker 脚本里通过 env.ASSETS.fetch(request) 访问静态资源
    "binding": "ASSETS",
    // SPA 前端路由回落：未命中的路径返回 index.html（替代 Pages 时代的 _redirects）
    "not_found_handling": "single-page-application",
    // /api/* 直接进入 Worker 脚本代理，跳过静态资源查找
    // 前端已改为直连后端域名，这里仅作为旧客户端的过渡兜底；确认无旧客户端后可整项删除
    "run_worker_first": ["/api/*"]
  },
  // 运行时变量（非敏感值才放这里，会随配置明文可见）：
  // API_UPSTREAM = 真实后端地址，只填协议+域名（如 https://api.example.com），
  // 不带 /api、不带结尾斜杠；误填成带路径的接口地址会导致 /api/api/... 双前缀、全部 401
  // 密钥类变量不要写在这里，用 `wrangler secret put <NAME>` 注入
  "vars": {
    "API_UPSTREAM": "https://api.example.com"
  }
}
