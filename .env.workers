# =========================================================
# Workers 构建模式（Cloudflare Workers 部署）
# 命令：npm run build / npm run build:workers
# 产物目录：dist-workers/（wrangler.jsonc 的 assets.directory 指向此处）
# =========================================================
# 关闭 Mock：Vite 打包时把 @/api/mock 别名替换为空壳，演示数据不进产物
VITE_USE_MOCK=false
# 直连后端（DNS-only，不经过 Worker 的 /api 兜底代理）：只填协议+域名，
# request.js 会统一补 /api；误填以 /api 结尾也只会被剥掉，不会出现 /api/api
VITE_API_BASE_URL=https://api.zhangjunyi.top
